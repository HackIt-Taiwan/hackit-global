# No runtime secrets, API credentials, or IP-geolocation service are required.
# These optional variables configure the process, never the site's public URL.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Canonical origin, visibility and indexing are explicit build configuration in
# source/site-config.json; rebuild after changing it. No geo headers are trusted.
# The Node server does not automatically load .env files. Coolify passes env vars.
